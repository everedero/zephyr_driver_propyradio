 *
 * arduino_spi defaults: SCK P0.25, MOSI P0.23, MISO P0.24, CS D10/P0.22
 */

/ {
	zephyr,user {
		gdo0-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; /* A0 */
	};
};

&arduino_spi {
	cc2500: cc2500@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <500000>;
	};
};
