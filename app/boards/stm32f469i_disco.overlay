/ {
	zephyr,user {
		/* adjust channel number according to pinmux in board.dts */
		io-channels = <&adc1 9>, <&adc1 12>,
			<&adc1 13>, <&adc1 14>,
			<&adc1 15>, <&adc1 4>;

		/* period cell corresponds to initial period */
		pwms = <&pwm1 1 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
	};
};

&timers3 {
	st,prescaler = <8>;
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim3_ch1_pa6>;
		pinctrl-names = "default";
		#pwm-cells = <3>;
		status = "okay";
	};
};


/* Activation I2C1 (Arduino connector) */
&arduino_i2c {
    status = "okay";

    pcf8575: gpio_expander@20 {
        compatible = "nxp,pcf857x";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
		ngpios = <16>;
		int-gpios = <&gpiog 13 GPIO_ACTIVE_LOW>;
        status = "okay";
    };
};


&dma2 {
	status = "okay";
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&adc1_in9_pb1>, <&adc1_in12_pc2>,
		<&adc1_in13_pc3>, <&adc1_in14_pc4>,
		<&adc1_in15_pc5>, <&adc1_in4_pa4>;
	pinctrl-names = "default";
	st,adc-prescaler = <2>;

	dmas = <&dma2 0 0 (STM32_DMA_PERIPH_RX | STM32_DMA_PERIPH_16BITS | STM32_DMA_MEM_16BITS ) STM32_DMA_FIFO_FULL>;
	dma-names = "dma";

	channel@9 {
		reg = <9>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
	channel@c {
		reg = <0xc>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
	channel@d {
		reg = <0xd>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
	channel@e {
		reg = <0xe>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
	channel@f {
		reg = <0xf>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};

&spi2 {
	cs-gpios = <&arduino_header 10 GPIO_ACTIVE_LOW>;
	clock-frequency = <8000000>; // Max 8 Mbps for SPI

};


&arduino_spi {
	radio0: nrf24@0 {
		reg = <0>;
		compatible = "nordic,nrf24l01";
		status = "okay";
		addr-width = <5>;
		spi-max-frequency = <500000>; // Max 8 Mbps for SPI
		ce-gpios = <&arduino_header 13 GPIO_ACTIVE_HIGH>; /* D7 */
		irq-gpios = <&arduino_header 15 GPIO_ACTIVE_LOW>; /* D9 */
		channel-frequency = <76>;
		lna-gain;
		rf-power-attenuation = <18>;
		tx-address = [00 00 00 00 01]; // [ab cd ab cd 71];    
		payload-fixed-size = <32>;
		rx-datapipes-number = <2>;
		rx-datapipe0-address = [00 00 00 00 01]; // [ab cd ab cd 71];
		rx-datapipe1-address = [00 00 00 00 ff]; // [ab cd ab cd 72];
		// payload-ack;
		payload-crc;
		crc-encoding-twobytes;
	};
};
